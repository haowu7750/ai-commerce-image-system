# Application
APP_ENVIRONMENT=development
APP_NAME=AI电商运营助手
APP_WEB_ORIGIN=http://127.0.0.1:3100
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100/api/v1
APP_DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5532/ecommerce_ai

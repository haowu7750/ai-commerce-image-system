# Copy this file to backend/.env for local development. Never place real keys in source control.
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_DATABASE_URL=sqlite:///./commerce_image.db
APP_AUTO_CREATE_TABLES=true
APP_SEED_DEMO_DATA=true
APP_DEMO_PASSWORD=replace-with-a-local-demo-password

# A random value is generated at process start when omitted. Set a stable secret for persistent sessions.
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_ACCESS_TOKEN_EXPIRE_MINUTES=480

# mock is the safe default. These APP_* values override compatible SHULICODE_*
# values read from the workspace root .env.local. Loading a key does not enable network calls.
# Set APP_IMAGE_PROVIDER=shulicode only when you intentionally want paid network calls.
APP_IMAGE_PROVIDER=mock
APP_IMAGE_API_BASE_URL=https://shulicode.xyz/v1
APP_IMAGE_API_KEY=
APP_IMAGE_MODEL=gpt-image-2
APP_IMAGE_REQUEST_TIMEOUT_SECONDS=120
